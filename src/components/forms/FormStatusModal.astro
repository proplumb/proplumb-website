<div
  class="fixed inset-0 z-50 flex items-center justify-center bg-black/80 px-6 opacity-0 pointer-events-none transition duration-300"
  data-status-modal
  aria-hidden="true"
>
  <div
    class="relative w-full max-w-[680px] border border-white/10 bg-[#191919] px-8 py-12 text-center shadow-[0_35px_80px_rgba(0,0,0,0.55)] sm:px-16 sm:py-14"
  >
    <button
      type="button"
      class="absolute right-5 top-4 text-white/45 transition hover:text-white"
      aria-label="Close status message"
      data-close-modal
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.5"
        class="h-5 w-5"
      >
        <path stroke-linecap="round" stroke-linejoin="round" d="M6 6 18 18"
        ></path>
        <path stroke-linecap="round" stroke-linejoin="round" d="M18 6 6 18"
        ></path>
      </svg>
    </button>

    <div class="mx-auto mb-8 flex justify-center">
      <div
        class="flex h-20 w-20 items-center justify-center rounded-full border border-white/10 bg-[#121212]"
        data-status-icon-wrap
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.75"
          class="h-10 w-10"
          data-status-icon
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="m4.5 12.75 6 6 9-13.5"></path>
        </svg>
      </div>
    </div>

    <p class="text-3xl leading-none text-white/80" data-status-kicker>
      Thanks for
    </p>
    <h3
      class="mt-2 text-3xl font-semibold leading-none tracking-[-1px]"
      data-status-title
    >
      Getting in Touch
    </h3>
    <p
      class="mx-auto mt-8 max-w-md text-sm leading-6 text-white/70"
      data-status-message
    >
      Your message has been sent to our team. We’ll review your enquiry and get
      back to you as soon as possible.
    </p>
  </div>
</div>
