---
import Image from "astro/components/Image.astro";

const services = [
  {
    title: "Civil & Drainage",
    description:
      "Stormwater, sewer, and civil works delivered with disciplined planning, clear communication, and built-in quality controls.",
    image: import("../assets/images/problump-worksite-1.webp"),
    category: "drainage",
  },
  {
    title: "Plumbing",
    description:
      "End-to-end plumbing solutions for volume housing, medium density, and commercial projects, delivered with reliable scheduling and consistent site execution.",
    image:
      import("../assets/images/proplumb_mediumdensity_evergreen_internalphotos.webp"),
    category: "plumbing",
  },
];
---

<section class="relative z-30 bg-primary pt-6 pb-14 lg:pt-14 md:py-20">
  <div class="mx-auto w-full max-w-[1240px] px-6 md:px-10">
    <div
      class="grid items-start gap-10 xl:grid-cols-[minmax(0,664px)_minmax(0,467px)] xl:gap-[41px]"
    >
      <div
        class="grid gap-3 lg:grid-cols-2 md:gap-3 xl:gap-4 order-2 lg:order-1"
      >
        {
          services.map((service, index) => (
            <article
              class:list={[
                "group relative isolate h-[420px] overflow-hidden border border-[#1f1f1f] bg-[#0f0f0f] md:h-[490px] cursor-pointer",
                index % 2 === 0 ? "animate-fade-up" : "animate-fade-up",
                index === 1 ? "[--reveal-delay:120ms]" : "",
              ]}
            >
              <Image
                src={service.image}
                alt={service.title}
                class="size-full object-cover transition-transform duration-500 group-hover:scale-105"
              />
              <div class="absolute inset-0 bg-gradient-to-b from-transparent via-black/25 to-black/85" />

              <div class="absolute bottom-6 left-5 right-5 text-white">
                <h3 class="text-xl lg:text-2xl font-light leading-[24px]">
                  {service.title}
                </h3>
                <p class="mt-4 max-w-[278px] max-h-32 lg:max-h-0 overflow-hidden text-[14px] font-light leading-[20px] text-white opacity-100 lg:opacity-0 transition-all duration-300 group-hover:max-h-32 lg:group-hover:opacity-100">
                  {service.description}
                </p>
              </div>
            </article>
          ))
        }
      </div>

      <div
        class="flex flex-col gap-6 order-1 lg:order-2 text-center lg:text-start"
      >
        <h2 class="text-white animate-fade-right">
          Civil, Drainage & Plumbing Solutions for <span class="font-extrabold"
            >Professional Build Environments</span
          >
        </h2>
        <p class="animate-fade-right [--reveal-delay:120ms]">
          From volume housing and medium density developments to commercial and
          civil projects, ProPlumb delivers structured plumbing and drainage
          solutions that support predictable construction outcomes.
        </p>
        <p class="animate-fade-right [--reveal-delay:220ms]">
          Our structured systems, disciplined scheduling, and clear
          communication ensure projects are delivered safely, to plan, and in
          line with builder and regulatory requirements.
        </p>
      </div>
    </div>
  </div>
</section>
