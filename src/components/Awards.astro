---
import Image from "astro/components/Image.astro";

const awards = [
  {
    name: "Quality Business Award",
    image: import("../assets/images/new-awards/award-1.png"),
  },
  {
    name: "Master Plumbers Association",
    image: import("../assets/images/new-awards/award-2.png"),
  },
  {
    name: "Excellence in Service",
    image: import("../assets/images/new-awards/award-3.png"),
  },
  {
    name: "Industry Recognition",
    image: import("../assets/images/new-awards/award-4.png"),
  },
  {
    name: "Industry Recognition",
    image: import("../assets/images/new-awards/award-5-4.png"),
  },
  {
    name: "Industry Recognition",
    image: import("../assets/images/new-awards/award-6.png"),
  },
  {
    name: "Industry Recognition",
    image: import("../assets/images/new-awards/award-7.png"),
  },
  {
    name: "Industry Recognition",
    image: import("../assets/images/new-awards/award-9-2.png"),
  },
];
---

<section class="relative bg-primary py-14 flex flex-col z-30">
  <div
    class="container px-4 sm:px-6 lg:px-10 mx-auto bg-[#0F0F0F] border border-[#212121] rounded-xl overflow-hidden"
  >
    <!-- Content Section -->
    <div
      class="flex flex-col lg:flex-row items-center justify-between py-8 lg:py-0 lg:h-[640px]"
    >
      <div
        class="flex flex-col gap-6 lg:w-1/3 pt-10 text-center lg:text-start px-4"
      >
        <h2 class="animate-fade-right">
          Compliant. Certified. <br />
          <span class="font-bold">Highly Accurate.</span>
        </h2>
        <p class="animate-fade-right [--reveal-delay:120ms]">
          We hold all required plumbing industry certifications and insurances.
          For ProPlumb, compliance is the starting point, not the finish line.
        </p>
        <p class="animate-fade-right [--reveal-delay:220ms]">
          Every project is completed to ProPlumb’s internal quality benchmarks,
          supported by documented QA processes and accountable job close-out.
          Our focus on accuracy protects warranties, reduces rework, and
          delivers confidence long after handover.
        </p>
        <p class="animate-fade-right [--reveal-delay:320ms]">
          Safety documentation and site-specific OHS requirements are embedded
          into every stage of delivery.
        </p>
      </div>

      <!-- Mobile/Tablet Horizontal Marquee -->
      <div class="relative w-full mt-8 lg:hidden">
        <div class="overflow-hidden space-y-3">
          <div class="marquee-row flex w-max items-center gap-3">
            {
              awards.concat(awards).map((award) => (
                <div class="award-item-mobile h-[108px] w-[166px] sm:h-[124px] sm:w-[194px] bg-[#1A1A1A] border border-[#252525] flex items-center justify-center group px-4">
                  <Image
                    src={award.image}
                    alt={award.name}
                    class="max-h-[58px] sm:max-h-[68px] w-auto object-contain transition-all duration-300 group-hover:brightness-110"
                  />
                </div>
              ))
            }
          </div>
          <div class="marquee-row-reverse flex w-max items-center gap-3">
            {
              awards.concat(awards).map((award) => (
                <div class="award-item-mobile h-[108px] w-[166px] sm:h-[124px] sm:w-[194px] bg-[#1A1A1A] border border-[#252525] flex items-center justify-center group px-4">
                  <Image
                    src={award.image}
                    alt={award.name}
                    class="max-h-[58px] sm:max-h-[68px] w-auto object-contain transition-all duration-300 group-hover:brightness-110"
                  />
                </div>
              ))
            }
          </div>
        </div>
        <div
          class="pointer-events-none absolute inset-y-0 left-0 w-12 sm:w-16 bg-gradient-to-r from-[#0F0F0F] to-transparent"
        >
        </div>
        <div
          class="pointer-events-none absolute inset-y-0 right-0 w-12 sm:w-16 bg-gradient-to-l from-[#0F0F0F] to-transparent"
        >
        </div>
      </div>

      <!-- Awards Marquee Section -->
      <div class="lg:w-1/2 w-full mt-8 lg:mt-0 hidden lg:flex gap-4 h-full">
        <!-- First Marquee - Top to Bottom -->
        <div class="overflow-hidden flex-1">
          <div
            class="marquee-col flex flex-col items-center gap-3 animate-marquee-down"
          >
            {
              awards.concat(awards).map((award, index) => (
                <div class="award-item w-full h-full bg-[#1A1A1A] flex items-center justify-center hover:bg-[#99E4FF] transition-all duration-300 group px-8 py-14 xl:px-10">
                  <Image
                    src={award.image}
                    alt={award.name}
                    class="max-h-[170px] w-auto max-w-[78%] object-contain transition-all duration-300 group-hover:brightness-10 group-hover:contrast-200"
                  />
                </div>
              ))
            }
          </div>
        </div>

        <!-- Second Marquee - Bottom to Top -->
        <div class="overflow-hidden flex-1">
          <div
            class="marquee-col flex flex-col items-center gap-3 animate-marquee-up"
          >
            {
              awards.concat(awards).map((award, index) => (
                <div class="award-item w-full h-full bg-[#1A1A1A] flex items-center justify-center hover:bg-[#99E4FF] transition-all duration-300 group px-8 py-14 xl:px-10">
                  <Image
                    src={award.image}
                    alt={award.name}
                    class="max-h-[170px] w-auto max-w-[78%] object-contain transition-all duration-300 group-hover:brightness-10 group-hover:contrast-200"
                  />
                </div>
              ))
            }
          </div>
        </div>
      </div>
    </div>
  </div>

  <style>
    .marquee-row {
      animation: marquee-row 18s linear infinite;
    }

    .marquee-row:hover {
      animation-play-state: paused;
    }

    .marquee-row-reverse {
      animation: marquee-row-reverse 18s linear infinite;
    }

    .marquee-row-reverse:hover {
      animation-play-state: paused;
    }

    .marquee-col {
      height: max-content;
    }

    .animate-marquee-down {
      animation: marquee-down 30s linear infinite;
    }

    .animate-marquee-up {
      animation: marquee-up 30s linear infinite;
    }

    .award-item:hover ~ .marquee-col,
    .award-item:hover {
      animation-play-state: paused;
    }

    .marquee-col:hover {
      animation-play-state: paused;
    }

    @keyframes marquee-down {
      0% {
        transform: translateY(-50%);
      }
      100% {
        transform: translateY(0%);
      }
    }

    @keyframes marquee-up {
      0% {
        transform: translateY(0%);
      }
      100% {
        transform: translateY(-50%);
      }
    }

    @keyframes marquee-row {
      0% {
        transform: translateX(0%);
      }
      100% {
        transform: translateX(-50%);
      }
    }

    @keyframes marquee-row-reverse {
      0% {
        transform: translateX(-50%);
      }
      100% {
        transform: translateX(0%);
      }
    }
  </style>
</section>
