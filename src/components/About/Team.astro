---
import about1 from "../../assets/images/about/about-1.png";
import about2 from "../../assets/images/about/about-2.png";
import about3 from "../../assets/images/about/about-3.png";

const teamMembers = [
  {
    name: "Adam Lowndes",
    title: "Founder & Managing Director",
    image: about1,
    showCaption: true,
  },
  {
    name: "Andrew Duran",
    title: "General Manager",
    image: about2,
    showCaption: false,
  },
  {
    name: "Abbi Hicken",
    title: "Office Manager",
    image: about3,
    showCaption: false,
  },
];
---

<section class="bg-black py-14 lg:py-20 text-white">
  <div class="mx-auto w-full max-w-[1360px] px-4 lg:px-6">
    <h2 class="text-center leading-[0.95] tracking-[-2px] mb-10 lg:mb-14 animate-fade-up">
      <span class="font-semibold">Leadership</span> That Builds<br />
      the Future
    </h2>

    <div
      class="mx-auto grid max-w-[1260px] grid-cols-2 gap-2 lg:grid-cols-3 lg:gap-5"
    >
      {
        teamMembers.map((member, index) => (
          <article
            class:list={[
              "group relative overflow-hidden bg-[#101010] transition-all duration-300 lg:cursor-pointer",
              index === 0
                ? "col-span-2 aspect-[16/10] lg:col-span-1 lg:row-span-1 lg:aspect-[0.68]"
                : "col-span-1 aspect-[4/5] lg:aspect-[0.68]",
              "animate-fade-up",
            ]}
          >
            <div class="relative h-full">
              <img
                src={member.image.src}
                alt={member.name}
                class="h-full w-full object-cover"
              />

              <div class="absolute bottom-2 left-2 right-2 bg-black/90 px-3 py-2 opacity-100 transition-all duration-300 lg:px-4 lg:py-3 lg:opacity-0 lg:group-hover:opacity-100">
                <span class="text-base font-bold leading-[1] text-white lg:text-2xl">
                  {member.name}
                </span>
                <br />
                <span class="mt-1 text-xs leading-[1.15] text-white/90 lg:text-base">
                  {member.title}
                </span>
              </div>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>
