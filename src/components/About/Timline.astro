---
const items = [
  {
    side: "left",
    datePrimary: "Jul",
    dateSecondary: "2005",
    titlePrimary: "ProPlumb",
    titleSecondary: "Established",
    paragraphs: [
      "ProPlumb was founded by Adam Lowndes with the goal of delivering professional, dependable plumbing services to Melbourne's South East.",
      "From the beginning, the business was built on structure, accountability, and doing the job properly, setting a clear standard for how work would be delivered.",
    ],
  },
  {
    side: "right",
    datePrimary: "Aug",
    dateSecondary: "2005",
    titlePrimary: "First",
    titleSecondary: "Apprentice",
    paragraphs: [
      "ProPlumb employed its first apprentice, Andrew Duran.",
      "Andrew has grown with the business for more than 30 years and now serves as General Manager, reflecting a long-term commitment to developing people from within.",
    ],
  },
  {
    side: "left",
    datePrimary: "Aug",
    dateSecondary: "2007",
    titlePrimary: "Committing",
    titleSecondary: "to Growth",
    paragraphs: [
      "ProPlumb moved from a home garage into its first commercial premises in Pakenham.",
      "This step marked a deliberate commitment to increased capacity, expansion, and supporting a growing team and workload.",
    ],
  },
  {
    side: "right",
    datePrimary: "Apr",
    dateSecondary: "2012",
    titlePrimary: "Building",
    titleSecondary: "the Team",
    paragraphs: [
      "ProPlumb expanded from 15 to 65 team members in response to growing demand.",
      "Clear leadership, defined standards, and a structured environment helped attract and retain skilled people as the business scaled.",
    ],
  },
  {
    side: "left",
    datePrimary: "May",
    dateSecondary: "2013",
    titlePrimary: "First Industry",
    titleSecondary: "Recognition",
    paragraphs: [
      "ProPlumb received its first major industry recognition at the Cardinia Business Awards, winning the Property, Trades & Construction category and being named a finalist in Innovation.",
      "This milestone marked the point where ProPlumb's approach and delivery began to be formally recognised beyond its immediate client base.",
    ],
  },
  {
    side: "right",
    datePrimary: "2014",
    dateSecondary: "onwards",
    titlePrimary: "Systems",
    titleSecondary: "Set the Standard",
    paragraphs: [
      "As the business continued to grow, ProPlumb's structured approach to planning, scheduling, and quality control became a clear point of difference.",
      "Systems were refined and embedded to support scale, reduce risk, and deliver consistent outcomes across high-volume and complex projects.",
    ],
  },
  {
    side: "left",
    datePrimary: "2016",
    dateSecondary: "onwards",
    titlePrimary: "Trusted Supplier",
    titleSecondary: "to Leading Builders",
    paragraphs: [
      "Consistent delivery across high-volume construction programs led to multiple Best Supplier and Supplier of the Year awards from major national builders.",
      "These awards reflect reliability, program discipline, and performance delivered consistently over time.",
    ],
  },
  {
    side: "right",
    datePrimary: "Feb",
    dateSecondary: "2021",
    titlePrimary: "10,000 Homes",
    titleSecondary: "Delivered",
    paragraphs: [
      "ProPlumb surpassed 10,000 completed home installations across Melbourne's South East.",
      "This milestone reflects the experience, systems, and planning discipline required to deliver at scale while maintaining quality and predictable timeframes.",
    ],
  },
  {
    side: "left",
    datePrimary: "Feb",
    dateSecondary: "2022",
    titlePrimary: "Commitment",
    titleSecondary: "to Giving Back",
    paragraphs: [
      "As the business matured, ProPlumb made a conscious decision to actively give back to the community.",
      "This includes supporting local initiatives and organisations such as Live 2 Achieve, reflecting the values shared by the owners and team.",
    ],
  },
  {
    side: "right",
    datePrimary: "May",
    dateSecondary: "2022",
    titlePrimary: "Purpose-Built",
    titleSecondary: "Headquarters",
    paragraphs: [
      "ProPlumb moved into a purpose-built office and factory facility designed to support long-term growth and operational coordination.",
      "The new headquarters enables closer alignment between field teams, civil operations, administration, and logistics.",
    ],
  },
  {
    side: "left",
    datePrimary: "Jul",
    dateSecondary: "2025",
    titlePrimary: "20 Years",
    titleSecondary: "of ProPlumb",
    paragraphs: [
      "ProPlumb marks 20 years of steady growth and dependable delivery across residential, civil, and commercial projects.",
      "This milestone also recognises the strength of the team, with an average tenure exceeding seven years, highlighting the people behind the business.",
    ],
  },
];

const desktopCardBaseClass =
  "timeline-card relative w-full max-w-[520px] bg-[#222222] px-7 py-6 text-white";
const desktopCardSideClass = {
  left: "col-start-1 justify-self-end",
  right: "col-start-2 justify-self-start",
} as const;
const desktopArrowSideClass = {
  left: "timeline-card-arrow-left -right-[22px] border-y-[22px] border-l-[23px] border-y-transparent",
  right:
    "timeline-card-arrow-right -left-[22px] border-y-[22px] border-r-[23px] border-y-transparent",
} as const;
---

<section
  class="relative overflow-hidden border-y border-white/10 py-16 lg:py-24"
>
  <div class="absolute inset-0 bg-black"></div>
  <!-- <div class="absolute inset-x-0 bottom-0 top-[380px] bg-[#cfcfcf]"></div> -->

  <div class="relative mx-auto w-full max-w-[1240px] px-6 md:px-10">
    <h2 class="text-center text-white animate-fade-up">
      Milestones in<br />
      <span class="font-semibold">ProPlumb's Journey</span>
    </h2>

    <div
      class="timeline-root relative mx-auto mt-16 max-w-[1060px] lg:mt-20"
      data-timeline-root
    >
      <div
        class="absolute left-[13px] top-0 h-full w-[3px] overflow-hidden bg-white/15 sm:left-[17px] lg:hidden"
      >
        <span
          class="timeline-line-fill absolute inset-x-0 top-0 h-full origin-top bg-gradient-to-b from-white via-[#d6d6d6] to-[#7d7d7d]"
          data-timeline-line></span>
      </div>
      <div
        class="absolute left-1/2 top-0 hidden h-full w-[5px] -translate-x-1/2 overflow-hidden bg-white/15 lg:block"
      >
        <span
          class="timeline-line-fill absolute inset-x-0 top-0 h-full origin-top bg-gradient-to-b from-white via-[#d6d6d6] to-[#7d7d7d]"
          data-timeline-line></span>
      </div>

      <div class="space-y-6 sm:space-y-8 lg:-space-y-12">
        {
          items.map((item, idx) => (
            <div
              class="timeline-item relative pl-9 sm:pl-12 lg:pl-0"
              data-timeline-item
              data-timeline-index={idx}
            >
              <div class="hidden lg:block">
                <div class="grid grid-cols-2 items-center gap-[100px]">
                  <article
                    class:list={[
                      desktopCardBaseClass,
                      desktopCardSideClass[item.side],
                    ]}
                  >
                    <span
                      class:list={[
                        "timeline-card-arrow absolute top-1/2 h-0 w-0 -translate-y-1/2",
                        desktopArrowSideClass[item.side],
                      ]}
                    />

                    <div class="flex items-start gap-4">
                      <div class="min-w-[78px] text-right space-y-2">
                        <p class="text-3xl font-extrabold leading-[0.9] tracking-[-1.5px] text-[#7d7d7d] ">
                          {item.datePrimary}
                        </p>
                        <p class="text-3xl font-light leading-[0.9] tracking-[-1.5px] text-[#7d7d7d]">
                          {item.dateSecondary}
                        </p>
                      </div>
                      <div class="space-y-2">
                        <h3 class="text-3xl font-extrabold leading-[0.92] tracking-[-1.5px]">
                          {item.titlePrimary}
                        </h3>
                        <p class="text-3xl font-light leading-[0.92] tracking-[-1.5px]">
                          {item.titleSecondary}
                        </p>
                      </div>
                    </div>

                    <div class="mt-5 space-y-4">
                      {item.paragraphs.map((paragraph) => (
                        <p class="text-[20px] leading-[1.33] text-white">
                          {paragraph}
                        </p>
                      ))}
                    </div>
                  </article>
                </div>

                <span
                  class={`timeline-node absolute left-1/2 top-1/2 z-20 h-9 w-9 -translate-x-1/2 -translate-y-1/2 rounded-full border-[6px] border-[#7b7b7b] bg-[#d6d6d6]`}
                />
              </div>

              <span class="timeline-node absolute left-[13px] top-7 z-20 h-7 w-7 -translate-x-1/2 rounded-full border-[5px] border-[#7b7b7b] bg-[#d6d6d6] sm:left-[17px] sm:top-8 sm:h-8 sm:w-8 lg:hidden" />

              {/* Mobile and tablet view with the same milestone spine and nodes */}
              <article class="timeline-card relative border border-white/10 bg-[#222222] px-4 py-4 text-white sm:px-5 sm:py-5 lg:hidden">
                <span class="timeline-card-mobile-arrow-border absolute -left-[17px] top-7 h-0 w-0 border-y-[17px] border-r-[17px] border-y-transparent sm:-left-[19px] sm:top-8 sm:border-y-[19px] sm:border-r-[19px]" />
                <span class="timeline-card-arrow timeline-card-arrow-right absolute -left-4 top-7 z-10 h-0 w-0 border-y-[16px] border-r-[16px] border-y-transparent sm:-left-[18px] sm:top-8 sm:border-y-[18px] sm:border-r-[18px]" />

                <div class="mb-4 flex space-x-4">
                  <div class="space-y-2 text-right">
                    <p class="text-start text-[22px] font-medium leading-[0.9] tracking-[-0.8px] text-[#8d8d8d] sm:text-[28px]">
                      {item.datePrimary}
                    </p>
                    <p class="text-[22px] font-medium leading-[0.9] tracking-[-0.8px] text-[#8d8d8d] sm:text-[28px]">
                      {item.dateSecondary}
                    </p>
                  </div>
                  <div class="space-y-1">
                    <h3 class="text-[24px] font-semibold leading-[0.96] tracking-[-0.9px] sm:text-[28px]">
                      {item.titlePrimary}
                    </h3>
                    <p class="text-[24px] font-light leading-[0.96] tracking-[-0.9px] sm:text-[28px]">
                      {item.titleSecondary}
                    </p>
                  </div>
                </div>

                <div class="space-y-3">
                  {item.paragraphs.map((paragraph) => (
                    <p class="text-[15px] leading-[1.45] text-[#d6d6d6] sm:text-[16px]">
                      {paragraph}
                    </p>
                  ))}
                </div>
              </article>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>

<style>
  .timeline-line-fill {
    transform: scaleY(0);
    box-shadow: 0 0 22px rgba(255, 255, 255, 0.32);
    will-change: transform;
  }

  .timeline-card {
    --timeline-card-bg: #222222;

    background-color: var(--timeline-card-bg);
    opacity: 0.34;
    transform: translateY(18px) scale(0.985);
    transition:
      opacity 420ms ease,
      transform 520ms cubic-bezier(0.22, 1, 0.36, 1),
      background-color 420ms ease,
      border-color 420ms ease,
      box-shadow 420ms ease;
    will-change: opacity, transform;
  }

  .timeline-card-arrow-left {
    border-left-color: var(--timeline-card-bg);
  }

  .timeline-card-arrow-right {
    border-right-color: var(--timeline-card-bg);
  }

  .timeline-card-mobile-arrow-border {
    border-right-color: rgba(255, 255, 255, 0.1);
  }

  .timeline-node {
    opacity: 0.45;
    scale: 0.86;
    transform-origin: center;
    transition:
      opacity 360ms ease,
      scale 420ms cubic-bezier(0.22, 1, 0.36, 1),
      transform 420ms cubic-bezier(0.22, 1, 0.36, 1),
      border-color 420ms ease,
      background-color 420ms ease,
      box-shadow 420ms ease;
  }

  .timeline-item.is-active .timeline-card {
    --timeline-card-bg: #242424;

    opacity: 1;
    transform: translateY(0) scale(1);
    border-color: rgba(255, 255, 255, 0.18);
    box-shadow: 0 22px 48px rgba(0, 0, 0, 0.34);
  }

  .timeline-item.is-active .timeline-card-mobile-arrow-border {
    border-right-color: rgba(255, 255, 255, 0.18);
  }

  .timeline-item.is-active .timeline-node {
    opacity: 1;
    scale: 1;
    border-color: #ffffff;
    background-color: #d6d6d6;
    box-shadow:
      0 0 0 8px rgba(255, 255, 255, 0.08),
      0 0 26px rgba(255, 255, 255, 0.28);
  }

  @media (prefers-reduced-motion: reduce) {
    .timeline-line-fill,
    .timeline-card {
      transition: none;
      transform: none;
      will-change: auto;
    }

    .timeline-node {
      scale: 1;
      transition: none;
      will-change: auto;
    }

    .timeline-card,
    .timeline-node {
      opacity: 1;
    }
  }
</style>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  const initTimelineAnimation = () => {
    gsap.registerPlugin(ScrollTrigger);

    ScrollTrigger.getAll().forEach((trigger) => {
      if (trigger.vars.id?.startsWith("about-timeline-")) {
        trigger.kill();
      }
    });

    const root = document.querySelector<HTMLElement>("[data-timeline-root]");
    if (!root) return;

    const reduceMotion = window.matchMedia(
      "(prefers-reduced-motion: reduce)",
    ).matches;
    const items = Array.from(
      root.querySelectorAll<HTMLElement>("[data-timeline-item]"),
    );
    const lineFills = Array.from(
      root.querySelectorAll<HTMLElement>("[data-timeline-line]"),
    );
    if (items.length === 0) return;

    const setActiveItem = (activeItem: HTMLElement) => {
      items.forEach((item) => {
        item.classList.toggle("is-active", item === activeItem);
      });
    };

    setActiveItem(items[0]);

    if (reduceMotion) {
      lineFills.forEach((line) => {
        line.style.transform = "scaleY(1)";
      });
      return;
    }

    lineFills.forEach((line) => {
      gsap.fromTo(
        line,
        { scaleY: 0 },
        {
          scaleY: 1,
          ease: "none",
          scrollTrigger: {
            id: "about-timeline-line",
            trigger: root,
            start: "top 68%",
            end: "bottom 58%",
            scrub: 0.7,
            invalidateOnRefresh: true,
          },
        },
      );
    });

    items.forEach((item, index) => {
      ScrollTrigger.create({
        id: `about-timeline-item-${index}`,
        trigger: item,
        start: "top 54%",
        end: "bottom 54%",
        invalidateOnRefresh: true,
        onEnter: () => setActiveItem(item),
        onEnterBack: () => setActiveItem(item),
      });
    });

    ScrollTrigger.refresh();
  };

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initTimelineAnimation, {
      once: true,
    });
  } else {
    initTimelineAnimation();
  }

  document.addEventListener("astro:page-load", initTimelineAnimation);
</script>
