---
import proplumbImage from "../../assets/images/showcase/Industrial-Development-7B.webp";
import shieldIcon from "../../assets/images/Pillars/shield.png";
import processIcon from "../../assets/images/Pillars/process.png";
import peopleIcon from "../../assets/images/Pillars/people.png";
import continualIcon from "../../assets/images/Pillars/continual.png";
import aboveIcon from "../../assets/images/Pillars/above.png";
import innovationIcon from "../../assets/images/Pillars/Innovation.png";
import { Image } from "astro:assets";

const pillars = [
  {
    title: "Built on Trust",
    description: "Consistency, transparency, and doing what we say.",
    icon: shieldIcon,
  },
  {
    title: "Continual Improvement",
    description: "Always refining how we plan and deliver work.",
    icon: processIcon,
  },
  {
    title: "People & Pathways",
    description: "Clear career development and leadership grown from within.",
    icon: peopleIcon,
  },
  {
    title: "Above & Beyond",
    description: "Our standard exists because our clients rely on the outcome.",
    icon: aboveIcon,
  },
  {
    title: "Process-Driven Results",
    description:
      "Structured systems that reduce risk and support repeatable delivery.",
    icon: continualIcon,
  },
  {
    title: "Innovation in Action",
    description:
      "Practical thinking applied to real site and delivery challenges.",
    icon: innovationIcon,
  },
];
---

<section
  class="relative overflow-hidden border-b border-white/10 py-14 text-white lg:py-20"
>
  <div class="absolute inset-0">
    <Image
      src={proplumbImage}
      alt=""
      class="h-full w-full object-cover blur-[0px]"
      aria-hidden="true"
    />
    <div class="absolute inset-0 bg-primary/60 backdrop-blur-sm"></div>
  </div>

  <div class="relative mx-auto w-full max-w-[1200px] px-4 md:px-6">
    <div class="mx-auto max-w-[980px] px-6 py-8 sm:px-8 lg:px-12 lg:py-11">
      <h2
        class="pb-14 text-center text-[44px] leading-[0.96] tracking-[-1.4px] sm:text-[52px] lg:mb-12 lg:text-[56px] animate-fade-up"
      >
        We're <span class="font-semibold">Built</span> On...
      </h2>

      <!-- Mobile view keeps the same card styling but stacks into one column -->
      <div
        class="grid grid-cols-1 gap-x-12 gap-y-7 sm:grid-cols-2 lg:gap-y-12 max-w-4xl"
      >
        {
          pillars.map((item) => (
            <article class="flex items-start gap-6 animate-fade-up">
              <div class="flex h-[72px] w-[72px] shrink-0 items-center justify-center bg-white/10">
                <Image
                  src={item.icon}
                  alt={`${item.title} icon`}
                  class="h-[52px] w-[52px] object-contain"
                />
              </div>

              <div>
                <h3 class="text-xl font-bold leading-[1.1] tracking-[-0.4px] text-white md:text-2xl">
                  {item.title}
                </h3>
                <p class="mt-2 text-[15px] leading-[1.3] text-white sm:text-[16px]">
                  {item.description}
                </p>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </div>
</section>
