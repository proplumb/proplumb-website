          </p>
        </div>
      </div>

      <div
        class="our-story-video-frame relative h-[540px] overflow-hidden md:h-auto animate-fade-left"
      >
        <iframe
          id="our-story-video"
          class="our-story-vimeo"
          src="https://player.vimeo.com/video/1189715309?badge=0&autopause=0&player_id=0&app_id=58479&autoplay=1&muted=1&loop=1&controls=0&playsinline=1"
          frameborder="0"
          allow="autoplay; fullscreen; picture-in-picture; clipboard-write; encrypted-media; web-share"
          referrerpolicy="strict-origin-when-cross-origin"
          title="ProPlumb Brand Story 9 16"></iframe>
        <div
          class="absolute inset-0 bg-gradient-to-b from-black/10 via-transparent to-black/45"
        >
        </div>

        <div class="absolute right-5 top-5 z-20 flex items-center gap-3">
          <button
            id="our-story-play-pause-btn"
            class="flex h-11 w-11 cursor-pointer items-center justify-center rounded-full bg-white/50 text-black transition"
            aria-label="Play or pause video"
          >
            <svg
              id="our-story-play-icon"
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 24 24"
              fill="currentColor"
              class="h-5 w-5 pl-[px] fill-white"
            >
              <path
                d="M8 5.14v13.72a1 1 0 0 0 1.52.85l10.7-6.86a1 1 0 0 0 0-1.7L9.52 4.29A1 1 0 0 0 8 5.14Z"
              ></path>
            </svg>
            <svg
              id="our-story-pause-icon"
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 24 24"
              fill="currentColor"
              class="hidden h-5 w-5 fill-white"
            >
              <path d="M8 5h3v14H8zm5 0h3v14h-3z"></path>
            </svg>
          </button>

          <button
            id="our-story-mute-btn"
            class="flex h-11 w-11 cursor-pointer items-center justify-center rounded-full bg-white/50 text-black transition"
            aria-label="Unmute video"
          >
            <svg
              id="our-story-muted-icon"
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="h-5 w-5 stroke-white"
            >
              <path d="M11 5 6 9H2v6h4l5 4V5Z"></path>
              <path d="m23 9-6 6"></path>
              <path d="m17 9 6 6"></path>
            </svg>
            <svg
              id="our-story-unmuted-icon"
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="hidden h-5 w-5 stroke-white"
            >
              <path d="M11 5 6 9H2v6h4l5 4V5Z"></path>
              <path d="M15.54 8.46a5 5 0 0 1 0 7.07"></path>
              <path d="M19.07 4.93a10 10 0 0 1 0 14.14"></path>
            </svg>
          </button>
        </div>
        <div
          class="absolute bottom-4 left-6 z-20 text-white md:bottom-5 md:left-6"
        >
          <div class="space-y-2 mt-4">
            <p class="mt-2 text-lg font-bold leading-none">Adam Lowndes</p>
            <p class="mt-1 text-lg leading-none text-[#eaeaea]">
              Founder &amp; Managing Director
            </p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .our-story-vimeo {
    height: 100%;
    left: 0;
    pointer-events: none;
    position: absolute;
    top: 0;
    width: 100%;
  }
</style>

<script>
  type VimeoPlayer = {
    play: () => Promise<void>;
    pause: () => Promise<void>;
    getPaused: () => Promise<boolean>;
    getMuted?: () => Promise<boolean>;
    setMuted?: (muted: boolean) => Promise<boolean>;
    setVolume: (volume: number) => Promise<number>;
    on: (eventName: string, callback: () => void) => void;
  };

  const loadVimeoPlayer = () => {
    const existingPlayer = (window as typeof window & { Vimeo?: unknown })
      .Vimeo;

    if (existingPlayer) {
      return Promise.resolve();
    }

    const existingScript = document.getElementById("vimeo-player-api");

    if (existingScript) {
      return new Promise<void>((resolve) => {
        existingScript.addEventListener("load", () => resolve(), {
          once: true,
        });
      });
    }

    return new Promise<void>((resolve, reject) => {
      const script = document.createElement("script");
      script.id = "vimeo-player-api";
      script.src = "https://player.vimeo.com/api/player.js";
      script.onload = () => resolve();
      script.onerror = () => reject();
      document.body.appendChild(script);
    });
  };

  const setVideoState = (
    isPlaying: boolean,
    playIcon: HTMLElement | null,
    pauseIcon: HTMLElement | null,
  ) => {
    playIcon?.classList.toggle("hidden", isPlaying);
    pauseIcon?.classList.toggle("hidden", !isPlaying);
  };

  const setAudioState = (
    isMuted: boolean,
    muteBtn: HTMLButtonElement | null,
    mutedIcon: HTMLElement | null,
    unmutedIcon: HTMLElement | null,
  ) => {
    muteBtn?.setAttribute(
      "aria-label",
      isMuted ? "Unmute video" : "Mute video",
    );
    mutedIcon?.classList.toggle("hidden", !isMuted);
    unmutedIcon?.classList.toggle("hidden", isMuted);
  };

  const initOurStoryVideo = async () => {
    const iframe = document.getElementById(
      "our-story-video",
    ) as HTMLIFrameElement | null;
    const playPauseBtn = document.getElementById(
      "our-story-play-pause-btn",
    ) as HTMLButtonElement | null;
    const playIcon = document.getElementById("our-story-play-icon");
    const pauseIcon = document.getElementById("our-story-pause-icon");
    const muteBtn = document.getElementById(
      "our-story-mute-btn",
    ) as HTMLButtonElement | null;
    const mutedIcon = document.getElementById("our-story-muted-icon");
    const unmutedIcon = document.getElementById("our-story-unmuted-icon");

    if (!iframe || !playPauseBtn) return;

    setVideoState(true, playIcon, pauseIcon);
    setAudioState(true, muteBtn, mutedIcon, unmutedIcon);

    try {
      await loadVimeoPlayer();
    } catch {
      setVideoState(false, playIcon, pauseIcon);
      return;
    }

    const Vimeo = (
      window as typeof window & {
        Vimeo?: { Player: new (el: Element) => VimeoPlayer };
      }
    ).Vimeo;
    const player = Vimeo ? new Vimeo.Player(iframe) : null;

    if (!player) return;

    player.on("play", () => setVideoState(true, playIcon, pauseIcon));
    player.on("pause", () => setVideoState(false, playIcon, pauseIcon));

    let isMuted = player.getMuted ? await player.getMuted() : true;
    setAudioState(isMuted, muteBtn, mutedIcon, unmutedIcon);

    playPauseBtn.addEventListener("click", async () => {
      const isPaused = await player.getPaused();

      if (isPaused) {
        await player.play();
        setVideoState(true, playIcon, pauseIcon);
      } else {
        await player.pause();
        setVideoState(false, playIcon, pauseIcon);
      }
    });

    muteBtn?.addEventListener("click", async () => {
      isMuted = !isMuted;

      if (player.setMuted) {
        await player.setMuted(isMuted);
      }

      await player.setVolume(isMuted ? 0 : 1);
      setAudioState(isMuted, muteBtn, mutedIcon, unmutedIcon);
    });
  };

  initOurStoryVideo();
</script>
