---
import Image from "astro/components/Image.astro";

const projects = [
  {
    image:
      import("../assets/images/showcase/Custom-Build-22-Elgin Street,-Berwick..webp"),
    title: "Custom Build - Berwick.",
    category: "High-End Residential Civil, Drainage & Plumbing.",
  },
  {
    image:
      import("../assets/images/showcase/Stockland-Evergreen-Development-Buildlab-Collaboration.webp"),
    title: "Stockland Evergreen Development - Buildlab Collaboration.",
    category: "Medium Density Residential Development Plumbing",
  },
  {
    image: import("../assets/images/showcase/Industrial-Development-7B.webp"),
    title: " Industrial Development - 7B",
    category:
      "Evolution Drive, Pakenham. Civil, Drainage & Commercial Plumbing.",
  },
];
---

<section class="relative bg-primary py-14 z-30">
  <div class="container px-10 mx-auto">
    <!-- Right Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-4 h-full">
      <!-- first Content -->
      <div class="flex flex-col justify-center gap-6">
        <h2 class="text-center lg:text-left animate-fade-right">
          Our Work <span class="font-bold">Speaks</span>
          <br class="" />
          for Itself
        </h2>
        <p
          class="text-center lg:text-left max-w-lg animate-fade-right [--reveal-delay:120ms]"
        >
          Across civil, drainage, and plumbing projects spanning residential,
          medium density, commercial, and industrial sectors, our work reflects
          the same high standard, delivered safely, on schedule, and to
          specification.
        </p>
        <p
          class="text-center lg:text-left max-w-lg animate-fade-right [--reveal-delay:220ms]"
        >
          For our clients, quality is measured by hitting agreed timeframes and
          delivering work that performs exactly as planned.
        </p>
      </div>
      <!-- 2nd content -->
      <div class="group mt-4 animate-fade-left">
        <div
          class="relative overflow-hidden h-[300px] lg:h-[400px] bg-gray-800"
        >
          <Image
            src={projects[0].image}
            alt={projects[0].title}
            sizes="(min-width: 1024px) 50vw, 100vw"
            class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500"
          />
          <div
            class="absolute inset-0 bg-gradient-to-t from-black/80 via-transparent to-transparent"
          >
          </div>
        </div>
        <div class="mt-2">
          <h3 class="text-white font-medium text-lg mb-1">
            {projects[0].title}
          </h3>
          <p class="text-gray-300 text-sm">{projects[0].category}</p>
        </div>
      </div>

      <!-- 3rd content -->
      <div
        class="group mt-0 lg:-mt-10 animate-fade-right [--reveal-delay:120ms]"
      >
        <div
          class="relative overflow-hidden h-[300px] lg:h-[440px] bg-gray-800"
        >
          <Image
            src={projects[1].image}
            alt={projects[1].title}
            sizes="(min-width: 1024px) 50vw, 100vw"
            class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500"
          />
          <div
            class="absolute inset-0 bg-gradient-to-t from-black/80 via-transparent to-transparent"
          >
          </div>
        </div>
        <div class="mt-2">
          <h3 class="text-white font-medium text-lg mb-1">
            {projects[1].title}
          </h3>
          <p class="text-gray-300 text-sm">{projects[1].category}</p>
        </div>
      </div>

      <!-- 4th content -->
      <div class="group animate-fade-left [--reveal-delay:220ms]">
        <div
          class="relative overflow-hidden h-[300px] lg:h-[400px] bg-gray-800"
        >
          <Image
            src={projects[2].image}
            alt={projects[2].title}
            sizes="(min-width: 1024px) 50vw, 100vw"
            class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500"
          />
          <div
            class="absolute inset-0 bg-gradient-to-t from-black/80 via-transparent to-transparent"
          >
          </div>
        </div>
        <div class="mt-2">
          <h3 class="text-white font-medium text-lg mb-1">
            {projects[2].title}
          </h3>
          <p class="text-gray-300 text-sm">{projects[2].category}</p>
        </div>
      </div>
    </div>
  </div>
</section>
